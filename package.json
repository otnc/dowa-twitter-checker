{
  "name": "dowa-twitter-checker",
  "version": "2.0.2",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "check": "ncu",
    "up": "ncu -u && npm install",
    "clean": "rimraf dist",
    "build": "node scripts/sync-version.js && npm run clean && cross-env TARGET=chrome vite build && node scripts/package.js chrome && cross-env TARGET=firefox vite build && node scripts/package.js firefox && web-ext build --source-dir dist/firefox --artifacts-dir dist --overwrite-dest && node scripts/rename-xpi.js",
    "webext:lint": "web-ext lint --source-dir dist/firefox",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "dowa": "^2.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.3.2",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "npm-check-updates": "^19.6.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "web-ext": "^9.3.0"
  }
}
